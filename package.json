{
  "name": "pantau",
  "version": "1.0.0",
  "private": true,
  "description": "PANTAU — Pantau Aset Nabung Terus Atur Uang. Expense tracker untuk anak muda Indonesia.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "npm --prefix backend install",
    "build": "npm --prefix backend install --omit=dev",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "demo": "npm --prefix backend run demo",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "joi": "18.2.9",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.1"
  }
}
