# Salin ke .env lalu isi. JANGAN commit file .env.

# Koneksi MongoDB (Atlas free tier: https://www.mongodb.com/atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=pantau_db

# Wajib diisi di production. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

PORT=3000
NODE_ENV=development

# Umur access token & refresh token
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Origin frontend yang boleh akses API (pisahkan dengan koma). Kosong/"*" = semua.
# Perlu diisi kalau frontend di-deploy terpisah (mis. Vercel).
CORS_ORIGIN=*

# Zona waktu untuk batas hari/bulan (menit dari UTC). WIB = 420, WITA = 480, WIT = 540.
APP_TZ_OFFSET_MINUTES=420
